import "fmt";
import "sdl";

fn main() -> i32 {
    bool init_ok, err ie = sdl.init(sdl.INIT_VIDEO());
    if (ie != ok) {
        fmt.eprintln(f"SDL init failed: {ie.message()}");
        return 1;
    }
    defer sdl.quit();

    sdl.Window win, err we = sdl.Window.create("Vigil SDL Window", 800, 600, sdl.WINDOW_RESIZABLE());
    if (we != ok) {
        fmt.eprintln(f"Window create failed: {we.message()}");
        return 1;
    }

    fmt.println(f"Window ID: {win.get_id()}");
    fmt.println(f"Title: {win.get_title()}");

    i32 w, i32 h = win.get_size();
    fmt.println(f"Size: {w}x{h}");

    bool title_ok, err te = win.set_title("Vigil SDL - Updated Title");
    if (te != ok) {
        fmt.eprintln(f"set_title failed: {te.message()}");
    }
    fmt.println(f"New title: {win.get_title()}");

    i32 flags = win.get_flags();
    fmt.println(f"Flags: {flags}");

    win.destroy();
    fmt.println("Window test complete.");
    return 0;
}
