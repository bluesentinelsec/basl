import "args"
import "fmt"
import "fs"
import "readline"

fn main() -> i32 {
    // No args: read from stdin (classic cat behavior)
    if args.count() == 0 {
        string line = readline.input("")
        while line.any() {
            fmt.println(line)
            line = readline.input("")
        }

        return 0
    }

    // Process each file argument
    for (i32 i = 0; i < args.count(); i++) {
        string path = args.at(i)
        // Support "-" for stdin
        if path == "-" {
            string line = readline.input("")
            while line.any() {
                fmt.println(line)
                line = readline.input("")
            }

        } else {
            if ! fs.exists(path) {
                fmt.eprintln(f"vigil-cat: {path}: No such file or directory")
                return 1
            }

            string content, err read_err = fs.read(path)
            if read_err != ok {
                fmt.eprintln(f"vigil-cat: {path}: read error")
                return 1
            }

            fmt.print(content)
        }

    }

    return 0
}
