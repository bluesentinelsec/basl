// argparse_example.vigil — Demonstrates the native args.Parser API.
//
// Usage:
//   vigil examples/argparse_example.vigil --help
//   vigil examples/argparse_example.vigil -v --input data.txt -f "*.csv" -f "*.json" -j 8 myfile.txt
//   vigil examples/argparse_example.vigil --input=data.txt --jobs=16 -- extra1 extra2

import "args"
import "fmt"

fn main() -> i32 {
    // Build a parser using the builder pattern
    args.Parser p = args.Parser.new("example", "Demonstrates the args.Parser API").version("1.0.0").flag("verbose", "v", "Enable verbose output").flag("dry-run", "n", "Show what would be done").option("input", "i", "Input file path", "").mark_required().option("output", "o", "Output file path", "out.txt").option_int("jobs", "j", "Number of parallel jobs", 4).option_f64("threshold", "t", "Score threshold", 0.5).option_choice("format", "f", "Output format", "json|csv|xml", "json").option_multi("filter", "F", "Filter pattern (repeatable)").required_positional("FILE", "File to process")

    // Parse arguments (--help and --version are handled automatically)
    err e = p.parse()
    if e != ok {
        fmt.eprintln(f"Error: {e.message()}")
        return 1
    }

    // Retrieve parsed values
    bool verbose = p.get_bool("verbose")
    bool dry_run = p.get_bool("dry-run")
    string input = p.get("input")
    string output = p.get("output")
    i32 jobs = p.get_int("jobs")
    f64 threshold = p.get_f64("threshold")
    string format = p.get("format")
    array<string> filters = p.get_multi("filter")
    array<string> positionals = p.get_positionals()

    // Display results
    fmt.println(f"verbose:     {verbose}")
    fmt.println(f"dry-run:     {dry_run}")
    fmt.println(f"input:       {input}")
    fmt.println(f"output:      {output}")
    fmt.println(f"jobs:        {jobs}")
    fmt.println(f"threshold:   {threshold}")
    fmt.println(f"format:      {format}")
    fmt.println(f"filters:     {filters.len()}")
    for (i32 i = 0; i < filters.len(); i++) {
        string fv = filters[i]
        fmt.println(f"  filter[{i}]: {fv}")
    }

    fmt.println(f"positionals: {positionals.len()}")
    for (i32 i = 0; i < positionals.len(); i++) {
        string pv = positionals[i]
        fmt.println(f"  pos[{i}]:    {pv}")
    }

    return 0
}
