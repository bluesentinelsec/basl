import "fmt"
import "sdl"

fn main() -> i32 {
    // Print SDL version info.
    i32 v = sdl.get_version()
    i32 major = v / 1000000
    i32 minor = (v / 1000) % 1000
    i32 patch = v % 1000
    fmt.println(f"SDL version: {major}.{minor}.{patch}")
    fmt.println(f"SDL revision: {sdl.get_revision()}")
    // Initialize video subsystem.
    bool init_ok, err e = sdl.init(sdl.INIT_VIDEO)
    if e != ok {
        fmt.eprintln(f"SDL init failed: {e.message()}")
        return 1
    }

    defer sdl.quit()
    // Verify it's initialized.
    i32 active = sdl.was_init(sdl.INIT_VIDEO)
    if active != 0 {
        fmt.println("Video subsystem initialized.")
    }

    fmt.println("SDL hello complete.")
    return 0
}
