import "fmt"
import "args"
import "fs"

fn main() -> i32 {
    fmt.println("===== TEST 06_ENV_AND_CONFIG START =====")

    // Env var builder
    args.Parser p1 = args.Parser.new("app", "desc")
        .option("host", "H", "Host", "localhost").env("VIGIL_TEST_HOST_12345")
        .option_int("port", "p", "Port", 8080).env("VIGIL_TEST_PORT_12345")
    string h1 = p1.help()
    fmt.println(f"env in help: {h1.contains("VIGIL_TEST_HOST_12345")}")

    // Parse with defaults (env vars not set)
    err e1 = p1.parse()
    fmt.println(f"parse ok: {e1 == ok}")
    fmt.println(f"host default: {p1.get("host")}")
    fmt.println(f"port default: {p1.get_int("port")}")

    // Config builder
    args.Parser p2 = args.Parser.new("app", "desc")
        .option("db", "d", "Database", "sqlite").config("database")
    string h2 = p2.help()
    fmt.println(f"config in help: {h2.contains("config:")}")

    // Config file loading
    string cfg = fs.join(fs.temp_dir(), "vigil_args_config_test.conf")
    err we = fs.write(cfg, "# Test config\ndatabase=postgres\nport=5432\n")
    fmt.println(f"config written: {we == ok}")

    args.Parser p3 = args.Parser.new("app", "desc")
        .option("db", "d", "Database", "sqlite").config("database")
        .option_int("port", "p", "Port", 3000).config("port")
    err le = p3.load_config(cfg)
    fmt.println(f"load_config: {le == ok}")
    err e3 = p3.parse()
    fmt.println(f"parse ok: {e3 == ok}")
    fmt.println(f"db from config: {p3.get("db")}")
    fmt.println(f"port from config: {p3.get_int("port")}")

    // Load missing config file
    args.Parser p4 = args.Parser.new("app", "desc")
    err le2 = p4.load_config("/nonexistent/path/config.conf")
    fmt.println(f"load missing: {le2 != ok}")

    fs.remove(cfg)

    fmt.println("===== TEST 06_ENV_AND_CONFIG END =====")
    return 0
}
