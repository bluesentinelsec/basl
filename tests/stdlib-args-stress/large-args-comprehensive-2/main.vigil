import "fmt"
import "args"

fn test_error_paths() -> void {
    // Required option
    args.Parser p1 = args.Parser.new("app", "desc")
        .option("key", "k", "API key", "").mark_required()
    err e1 = p1.parse()
    fmt.println(f"req opt: {e1 != ok}")

    // Required positional
    args.Parser p2 = args.Parser.new("app", "desc")
        .required_positional("file", "File")
    err e2 = p2.parse()
    fmt.println(f"req pos: {e2 != ok}")

    // Plus positional
    args.Parser p3 = args.Parser.new("app", "desc")
        .positional_plus("files", "Files")
    err e3 = p3.parse()
    fmt.println(f"plus pos: {e3 != ok}")

    // Multiple required
    args.Parser p4 = args.Parser.new("app", "desc")
        .option("a", "", "A", "").mark_required()
        .option("b", "", "B", "").mark_required()
        .option("c", "", "C", "default")
    err e4 = p4.parse()
    fmt.println(f"multi req: {e4 != ok}")
}

fn test_complex_builder() -> void {
    // Complex builder chain
    args.Parser p = args.Parser.new("complex", "Complex tool")
        .version("1.0.0")
        .subcommand("run", "Run task")
        .subcommand("stop", "Stop task")
        .flag("verbose", "v", "Verbose")
        .flag("quiet", "q", "Quiet")
        .option("config", "c", "Config", "app.conf")
        .option_int("workers", "w", "Workers", 4)
        .option_f64("timeout", "t", "Timeout", 30.0)
        .option_choice("env", "e", "Environment", "dev|staging|prod", "dev")
        .option_multi("plugin", "p", "Plugin")
        .required_positional("task", "Task name")
        .positional_star("args", "Task arguments")

    string h = p.help()
    fmt.println(f"complex help len: {h.len() > 100}")
    fmt.println(f"has commands: {h.contains("Commands:")}")
    fmt.println(f"has options: {h.contains("Options:")}")
    fmt.println(f"has arguments: {h.contains("Arguments:")}")
    fmt.println(f"has run: {h.contains("run")}")
    fmt.println(f"has verbose: {h.contains("--verbose")}")
    fmt.println(f"has workers: {h.contains("--workers")}")
    fmt.println(f"has choices: {h.contains("dev|staging|prod")}")
    fmt.println(f"has task: {h.contains("<task>")}")
    fmt.println(f"has args: {h.contains("[args...]")}")
}

fn test_accessor_defaults() -> void {
    args.Parser p = args.Parser.new("app", "desc")
        .flag("f", "", "Flag")
        .option("s", "", "Str", "default_str")
        .option_int("i", "", "Int", 99)
        .option_f64("d", "", "Float", 2.718)
        .option_choice("c", "", "Choice", "x|y|z", "y")
        .option_multi("m", "", "Multi")
    err e = p.parse()
    fmt.println(f"defaults ok: {e == ok}")
    fmt.println(f"f: {p.get_bool("f")}")
    fmt.println(f"s: {p.get("s")}")
    fmt.println(f"i: {p.get_int("i")}")
    fmt.println(f"d: {p.get_f64("d")}")
    fmt.println(f"c: {p.get("c")}")
    fmt.println(f"m: {p.get_multi("m").len()}")
    fmt.println(f"pos: {p.get_positionals().len()}")
    fmt.println(f"sub: [{p.get_subcommand()}]")
}

fn main() -> i32 {
    fmt.println("===== TEST LARGE_ARGS_COMPREHENSIVE_2 START =====")
    test_error_paths()
    test_complex_builder()
    test_accessor_defaults()
    fmt.println("===== TEST LARGE_ARGS_COMPREHENSIVE_2 END =====")
    return 0
}
