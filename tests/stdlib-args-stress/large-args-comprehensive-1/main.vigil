import "fmt"
import "args"
import "fs"

fn main() -> i32 {
    fmt.println("===== TEST LARGE_ARGS_COMPREHENSIVE_1 START =====")

    // Real-world deploy tool pattern
    args.Parser p = args.Parser.new("deploy", "Deploy to cloud")
        .version("3.2.1")
        .subcommand("staging", "Deploy to staging")
        .subcommand("production", "Deploy to production")
        .flag("verbose", "v", "Verbose")
        .flag("dry-run", "n", "Dry run")
        .option("region", "r", "AWS region", "us-east-1").env("DEPLOY_REGION")
        .option("profile", "p", "AWS profile", "default").env("AWS_PROFILE")
        .option_int("timeout", "t", "Timeout seconds", 300)
        .option_f64("scale", "s", "Scale factor", 1.0)
        .option_choice("strategy", "S", "Strategy", "rolling|blue-green|canary", "rolling")
        .option_multi("tag", "T", "Resource tag")

    // Verify help
    string h = p.help()
    fmt.println(f"has subcommands: {h.contains("Commands:")}")
    fmt.println(f"has staging: {h.contains("staging")}")
    fmt.println(f"has region: {h.contains("--region")}")
    fmt.println(f"has env: {h.contains("DEPLOY_REGION")}")
    fmt.println(f"has choices: {h.contains("rolling|blue-green|canary")}")

    // Parse defaults
    err e = p.parse()
    fmt.println(f"parse ok: {e == ok}")
    fmt.println(f"verbose: {p.get_bool("verbose")}")
    fmt.println(f"region: {p.get("region")}")
    fmt.println(f"timeout: {p.get_int("timeout")}")
    fmt.println(f"scale: {p.get_f64("scale")}")
    fmt.println(f"strategy: {p.get("strategy")}")
    fmt.println(f"tags: {p.get_multi("tag").len()}")
    fmt.println(f"subcmd: [{p.get_subcommand()}]")

    // Config file workflow
    string cfg = fs.join(fs.temp_dir(), "vigil_deploy_stress.conf")
    err we = fs.write(cfg, "region=eu-west-1\ntimeout=600\n")
    args.Parser p2 = args.Parser.new("app", "desc")
        .option("region", "r", "Region", "us-east-1").config("region")
        .option_int("timeout", "t", "Timeout", 300).config("timeout")
    err le = p2.load_config(cfg)
    err e2 = p2.parse()
    fmt.println(f"config region: {p2.get("region")}")
    fmt.println(f"config timeout: {p2.get_int("timeout")}")
    fs.remove(cfg)

    fmt.println("===== TEST LARGE_ARGS_COMPREHENSIVE_1 END =====")
    return 0
}
