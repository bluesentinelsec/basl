import "fmt"
import "args"

fn main() -> i32 {
    fmt.println("===== TEST 03_PARSING_AND_ACCESS START =====")

    // Parse with no CLI args — all defaults
    args.Parser p = args.Parser.new("app", "desc")
        .flag("verbose", "v", "Verbose")
        .option("output", "o", "Output", "default.txt")
        .option_int("jobs", "j", "Jobs", 8)
        .option_f64("rate", "r", "Rate", 3.14)
        .option_choice("mode", "m", "Mode", "fast|slow|auto", "auto")
        .option_multi("tag", "t", "Tag")
        .positional("file", "File")

    err e = p.parse()
    fmt.println(f"parse ok: {e == ok}")

    // get defaults
    fmt.println(f"verbose: {p.get_bool("verbose")}")
    fmt.println(f"output: {p.get("output")}")
    fmt.println(f"jobs: {p.get_int("jobs")}")
    fmt.println(f"rate: {p.get_f64("rate")}")
    fmt.println(f"mode: {p.get("mode")}")

    // get_multi with no values
    array<string> tags = p.get_multi("tag")
    fmt.println(f"tags: {tags.len()}")

    // get_positionals with no positionals
    array<string> pos = p.get_positionals()
    fmt.println(f"positionals: {pos.len()}")

    // get nonexistent option
    fmt.println(f"missing: [{p.get("nonexistent")}]")
    fmt.println(f"missing bool: {p.get_bool("nonexistent")}")
    fmt.println(f"missing int: {p.get_int("nonexistent")}")
    fmt.println(f"missing f64: {p.get_f64("nonexistent")}")

    fmt.println("===== TEST 03_PARSING_AND_ACCESS END =====")
    return 0
}
