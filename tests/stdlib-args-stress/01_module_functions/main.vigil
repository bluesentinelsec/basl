import "fmt"
import "args"

fn main() -> i32 {
    fmt.println("===== TEST 01_MODULE_FUNCTIONS START =====")

    // args.count() with no script args
    fmt.println(f"count: {args.count()}")

    // args.at() out of range
    fmt.println(f"at 0: [{args.at(0)}]")
    fmt.println(f"at -1: [{args.at(-1)}]")
    fmt.println(f"at 100: [{args.at(100)}]")

    fmt.println("===== TEST 01_MODULE_FUNCTIONS END =====")
    return 0
}
