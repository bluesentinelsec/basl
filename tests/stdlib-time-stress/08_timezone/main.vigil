import "fmt"
import "time"

fn main() -> i32 {
    fmt.println("===== TEST 08_TIMEZONE START =====")

    i64 ts = time.date(2024, 6, 15, 12, 0, 0)

    // utc_offset returns seconds
    i32 off = time.utc_offset(ts)
    fmt.println(f"offset is seconds: true")
    fmt.println(f"offset range: {off >= -43200 && off <= 50400}")

    // to_utc and from_utc are inverses
    i64 utc = time.to_utc(ts)
    i64 back = time.from_utc(utc)
    fmt.println(f"to_utc/from_utc roundtrip: {back == ts}")

    // format_utc gives UTC time
    i64 epoch = i64(0)
    string utc_fmt = time.format_utc(epoch, "%Y-%m-%d %H:%M:%S")
    fmt.println(f"epoch utc: {utc_fmt}")

    // format_utc vs format may differ (unless in UTC timezone)
    string local_fmt = time.format(epoch, "%Y-%m-%d %H:%M:%S")
    i32 epoch_off = time.utc_offset(epoch)
    if epoch_off == 0 {
        fmt.println(f"utc zone: formats match")
    } else {
        fmt.println(f"utc zone: formats differ")
    }

    // UTC components of epoch
    fmt.println(f"epoch utc_hour: {time.utc_hour(epoch)}")
    fmt.println(f"epoch utc_year: {time.utc_year(epoch)}")

    fmt.println("===== TEST 08_TIMEZONE END =====")
    return 0
}
