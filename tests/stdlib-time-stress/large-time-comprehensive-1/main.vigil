import "fmt"
import "time"

fn main() -> i32 {
    fmt.println("===== TEST LARGE_TIME_COMPREHENSIVE_1 START =====")

    // Scenario: Build a date range and iterate
    i64 start = time.date(2024, 1, 1, 0, 0, 0)
    i64 end_ts = time.date(2024, 1, 7, 0, 0, 0)
    i32 days = 0
    i64 cur = start
    while cur < end_ts {
        days = days + 1
        cur = time.add_days(cur, 1)
    }
    fmt.println(f"days in range: {days}")

    // Scenario: Format dates in UTC
    i64 ts = i64(1718451045)
    fmt.println(f"utc formatted: {time.format_utc(ts, "%Y-%m-%d %H:%M:%S")}")
    fmt.println(f"utc year: {time.utc_year(ts)}")
    fmt.println(f"utc month: {time.utc_month(ts)}")

    // Scenario: Parse and reformat
    i64 parsed, err pe = time.parse("2024-03-15", "%Y-%m-%d")
    fmt.println(f"parsed ok: {pe == ok}")
    fmt.println(f"parsed year: {time.year(parsed)}")
    fmt.println(f"parsed month: {time.month(parsed)}")

    // Scenario: Calendar arithmetic chain
    i64 base = time.date(2024, 1, 31, 12, 0, 0)
    i64 plus1m = time.add_months(base, 1)
    i64 plus2m = time.add_months(base, 2)
    i64 plus1y = time.add_years(base, 1)
    fmt.println(f"+1m: {time.month(plus1m)}/{time.day(plus1m)}")
    fmt.println(f"+2m: {time.month(plus2m)}/{time.day(plus2m)}")
    fmt.println(f"+1y: {time.year(plus1y)}/{time.month(plus1y)}")

    // Scenario: Diff calculations
    i64 meeting_start = time.date(2024, 6, 15, 9, 0, 0)
    i64 meeting_end = time.date(2024, 6, 15, 10, 30, 0)
    fmt.println(f"meeting hours: {time.diff_hours(meeting_end, meeting_start)}")
    fmt.println(f"meeting minutes: {time.diff_minutes(meeting_end, meeting_start)}")
    fmt.println(f"meeting seconds: {time.diff_seconds(meeting_end, meeting_start)}")

    // Scenario: Convenience formats
    fmt.println(f"iso: {time.iso8601(ts).contains("T")}")
    fmt.println(f"rfc3339: {time.rfc3339(ts).len() > 19}")
    fmt.println(f"rfc2822: {time.rfc2822(ts).contains(",")}")

    // Scenario: ms round-trip
    i64 now = time.now()
    i64 ms = time.to_ms(now)
    i64 back = time.from_ms(ms)
    fmt.println(f"ms roundtrip: {back == now}")

    fmt.println("===== TEST LARGE_TIME_COMPREHENSIVE_1 END =====")
    return 0
}
