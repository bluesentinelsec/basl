import "fmt"
import "encoding"

fn test_rfc_vectors_hex() -> void {
    // RFC 4648 test vectors for hex
    string r0, err e0 = encoding.hex_encode("")
    fmt.println(f"hex vec empty: {r0}")

    string r1, err e1 = encoding.hex_encode("f")
    fmt.println(f"hex vec f: {r1}")

    string r2, err e2 = encoding.hex_encode("fo")
    fmt.println(f"hex vec fo: {r2}")

    string r3, err e3 = encoding.hex_encode("foo")
    fmt.println(f"hex vec foo: {r3}")

    string r4, err e4 = encoding.hex_encode("foob")
    fmt.println(f"hex vec foob: {r4}")

    string r5, err e5 = encoding.hex_encode("fooba")
    fmt.println(f"hex vec fooba: {r5}")

    string r6, err e6 = encoding.hex_encode("foobar")
    fmt.println(f"hex vec foobar: {r6}")
}

