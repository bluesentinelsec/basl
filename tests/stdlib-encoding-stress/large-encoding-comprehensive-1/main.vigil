fn test_rfc_vectors_base32() -> void {
    // RFC 4648 test vectors
    string r0, err e0 = encoding.base32_encode("")
    fmt.println(f"b32 vec empty: {r0}")

    string r1, err e1 = encoding.base32_encode("f")
    fmt.println(f"b32 vec f: {r1}")

    string r2, err e2 = encoding.base32_encode("fo")
    fmt.println(f"b32 vec fo: {r2}")

    string r3, err e3 = encoding.base32_encode("foo")
    fmt.println(f"b32 vec foo: {r3}")

    string r4, err e4 = encoding.base32_encode("foob")
    fmt.println(f"b32 vec foob: {r4}")

    string r5, err e5 = encoding.base32_encode("fooba")
