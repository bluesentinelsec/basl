import "fmt"
import "compress"

fn test_roundtrip() -> void {
    string data = "hello gzip world"
    string compressed, err e1 = compress.gzip_compress(data)
    bool ok1 = e1 == ok
    fmt.println(f"gzip compress ok: {ok1}")
    string decompressed, err e2 = compress.gzip_decompress(compressed)
    bool ok2 = e2 == ok
    fmt.println(f"gzip decompress ok: {ok2}")
    bool match = decompressed == data
    fmt.println(f"gzip roundtrip match: {match}")
}

fn test_empty() -> void {
    string compressed, err e1 = compress.gzip_compress("")
    bool ok1 = e1 == ok
    fmt.println(f"gzip empty compress ok: {ok1}")
    string decompressed, err e2 = compress.gzip_decompress(compressed)
    bool ok2 = e2 == ok
    fmt.println(f"gzip empty decompress ok: {ok2}")
    bool empty = decompressed == ""
    fmt.println(f"gzip empty roundtrip: {empty}")
}

fn test_level() -> void {
    string data = "gzip level test with repeated content repeated content repeated content"
    string c1, err e1 = compress.gzip_compress_level(data, 1)
    bool ok1 = e1 == ok
    fmt.println(f"gzip level1 ok: {ok1}")
    string d1, err e2 = compress.gzip_decompress(c1)
    bool match1 = d1 == data
    fmt.println(f"gzip level1 roundtrip: {match1}")

    string c9, err e3 = compress.gzip_compress_level(data, 9)
    bool ok9 = e3 == ok
    fmt.println(f"gzip level9 ok: {ok9}")
    string d9, err e4 = compress.gzip_decompress(c9)
    bool match9 = d9 == data
    fmt.println(f"gzip level9 roundtrip: {match9}")
}

fn test_decompress_max() -> void {
    string data = "decompress max gzip test"
    string compressed, err e1 = compress.gzip_compress(data)
    string decompressed, err e2 = compress.gzip_decompress_max(compressed, 1024)
    bool ok2 = e2 == ok
    fmt.println(f"gzip decompress_max ok: {ok2}")
    bool match = decompressed == data
    fmt.println(f"gzip decompress_max match: {match}")
}

fn test_decompress_max_too_small() -> void {
    string data = "this string should exceed the max bytes limit for gzip decompression"
    string compressed, err e1 = compress.gzip_compress(data)
    string decompressed, err e2 = compress.gzip_decompress_max(compressed, 5)
    bool failed = e2 != ok
    fmt.println(f"gzip decompress_max too small fails: {failed}")
}

fn test_gzip_info() -> void {
    string data = "gzip info test data"
    string compressed, err e1 = compress.gzip_compress(data)
    map<string,string> info, err e2 = compress.gzip_info(compressed)
    bool ok2 = e2 == ok
    fmt.println(f"gzip info ok: {ok2}")
    string method = info["method"]
    fmt.println(f"gzip info method: {method}")
    string size = info["size"]
    fmt.println(f"gzip info has size: {size.len() > 0}")
}

fn main() -> i32 {
    fmt.println("===== TEST 04_GZIP START =====")
    test_roundtrip()
    test_empty()
    test_level()
    test_decompress_max()
    test_decompress_max_too_small()
    test_gzip_info()
    fmt.println("===== TEST 04_GZIP END =====")
    return 0
}
