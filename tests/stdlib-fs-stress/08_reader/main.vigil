import "fmt"
import "fs"

fn bytes_to_string(array<u8> b) -> string {
    string s = ""
    for v in b { s = s + char(i32(v)) }
    return s
}

fn main() -> i32 {
    fmt.println("===== TEST 08_READER START =====")

    string base = fs.join(fs.temp_dir(), "vigil_fs_08")
    err _ = fs.remove_all(base)
    err _ = fs.mkdir_all(base)

    // read_line
    string f1 = fs.join(base, "lines.txt")
    err _ = fs.write(f1, "line one\nline two\nline three")

    fs.Reader r1, err e1 = fs.Reader.open(f1)
    fmt.println(f"open: {e1 == ok}")
    string l1, err le1 = r1.read_line()
    fmt.println(f"line 1: {l1}")
    string l2, err le2 = r1.read_line()
    fmt.println(f"line 2: {l2}")
    string l3, err le3 = r1.read_line()
    fmt.println(f"line 3: {l3}")
    string l4, err le4 = r1.read_line()
    fmt.println(f"eof: {le4.kind() == err.eof}")
    err ce1 = r1.close()
    fmt.println(f"close: {ce1 == ok}")

    // read_all
    fs.Reader r2, err e2 = fs.Reader.open(f1)
    string all, err ae = r2.read_all()
    fmt.println(f"read_all len: {all.len()}")
    fmt.println(f"read_all ok: {ae == ok}")
    r2.close()

    // read_bytes (returns array<u8>)
    string f2 = fs.join(base, "bytes.txt")
    err _ = fs.write(f2, "abcdefghij")
    fs.Reader r3, err e3 = fs.Reader.open(f2)
    array<u8> b1, err be1 = r3.read_bytes(3)
    fmt.println(f"read_bytes 3: {bytes_to_string(b1)}")
    array<u8> b2, err be2 = r3.read_bytes(4)
    fmt.println(f"read_bytes 4: {bytes_to_string(b2)}")
    array<u8> b3, err be3 = r3.read_bytes(100)
    fmt.println(f"read_bytes rest: {bytes_to_string(b3)}")
    array<u8> b4, err be4 = r3.read_bytes(1)
    fmt.println(f"read_bytes eof: {be4.kind() == err.eof}")
    r3.close()

    // Read empty file
    string f3 = fs.join(base, "empty.txt")
    err _ = fs.write(f3, "")
    fs.Reader r4, err e4 = fs.Reader.open(f3)
    string el, err ele = r4.read_line()
    fmt.println(f"empty read_line eof: {ele.kind() == err.eof}")
    r4.close()

    // Read line by line in loop
    string f4 = fs.join(base, "loop.txt")
    err _ = fs.write(f4, "a\nb\nc\nd\ne")
    fs.Reader r5, err e5 = fs.Reader.open(f4)
    i32 count = 0
    while true {
        string line, err le = r5.read_line()
        if le != ok { break }
        count = count + 1
    }
    r5.close()
    fmt.println(f"loop lines: {count}")

    // seek and tell
    string f5 = fs.join(base, "seek.txt")
    err _ = fs.write(f5, "abcdefghij")
    fs.Reader r6, err e6 = fs.Reader.open(f5)
    i64 pos0, err te0 = r6.tell()
    fmt.println(f"tell start: {pos0}")
    array<u8> sb1, err sbe1 = r6.read_bytes(3)
    fmt.println(f"read 3: {bytes_to_string(sb1)}")
    i64 pos3, err te3 = r6.tell()
    fmt.println(f"tell after 3: {pos3}")
    err se1 = r6.seek(i64(0))
    fmt.println(f"seek 0: {se1 == ok}")
    array<u8> sb2, err sbe2 = r6.read_bytes(3)
    fmt.println(f"re-read: {bytes_to_string(sb2)}")
    err se2 = r6.seek(i64(7))
    array<u8> sb3, err sbe3 = r6.read_bytes(3)
    fmt.println(f"seek 7 read: {bytes_to_string(sb3)}")
    r6.close()

    // Cleanup
    err _ = fs.remove_all(base)

    fmt.println("===== TEST 08_READER END =====")
    return 0
}
