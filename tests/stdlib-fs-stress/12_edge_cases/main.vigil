import "fmt"
import "fs"

fn test_large_file() -> void {
    string base = fs.join(fs.temp_dir(), "vigil_fs_12")
    fs.remove_all(base)
    fs.mkdir_all(base)

    // Large file write/read
    string f = fs.join(base, "large.txt")
    string data = "x".repeat(10000)
    fs.write(f, data)
    fmt.println(f"large size: {fs.size(f)}")
    string content = fs.read(f)
    fmt.println(f"large read len: {content.len()}")
    fmt.println(f"large match: {content == data}")

    fs.remove_all(base)
}

fn test_many_files() -> void {
    string base = fs.join(fs.temp_dir(), "vigil_fs_12_many")
    fs.remove_all(base)
    fs.mkdir_all(base)

    for (i32 i = 0; i < 50; i++) {
        fs.write(fs.join(base, f"file_{i}.txt"), f"content {i}")
    }
    array<string> files = fs.list(base)
    fmt.println(f"many files: {files.len()}")

    // Verify a few
    fmt.println(f"file_0: {fs.read(fs.join(base, "file_0.txt"))}")
    fmt.println(f"file_49: {fs.read(fs.join(base, "file_49.txt"))}")

    fs.remove_all(base)
}

fn test_deep_dirs() -> void {
    string base = fs.join(fs.temp_dir(), "vigil_fs_12_deep")
    fs.remove_all(base)

    string deep = fs.join(base, "a/b/c/d/e")
    fs.mkdir_all(deep)
    fs.write(fs.join(deep, "deep.txt"), "deep content")
    fmt.println(f"deep exists: {fs.exists(fs.join(deep, "deep.txt"))}")
    fmt.println(f"deep read: {fs.read(fs.join(deep, "deep.txt"))}")

    // Walk should find it
    array<string> walked = fs.walk(base)
    i32 file_count = 0
    for w in walked {
        if fs.is_file(w) { file_count = file_count + 1 }
    }
    fmt.println(f"deep walk files: {file_count}")

    fs.remove_all(base)
}

fn test_empty_file() -> void {
    string base = fs.join(fs.temp_dir(), "vigil_fs_12_empty")
    fs.remove_all(base)
    fs.mkdir_all(base)

    string f = fs.join(base, "empty.txt")
    fs.write(f, "")
    fmt.println(f"empty size: {fs.size(f)}")
    fmt.println(f"empty read: [{fs.read(f)}]")
    fmt.println(f"empty exists: {fs.exists(f)}")

    fs.remove_all(base)
}

fn test_special_content() -> void {
    string base = fs.join(fs.temp_dir(), "vigil_fs_12_special")
    fs.remove_all(base)
    fs.mkdir_all(base)

    // Newlines
    string f1 = fs.join(base, "newlines.txt")
    fs.write(f1, "a\nb\nc\n")
    fmt.println(f"newlines size: {fs.size(f1)}")

    // Tabs
    string f2 = fs.join(base, "tabs.txt")
    fs.write(f2, "a\tb\tc")
    fmt.println(f"tabs read: {fs.read(f2)}")

    // Unicode
    string f3 = fs.join(base, "unicode.txt")
    fs.write(f3, "café 日本語 🎉")
    fmt.println(f"unicode read: {fs.read(f3)}")

    fs.remove_all(base)
}

fn test_temp_file() -> void {
    // Multiple temp files should be unique
    string t1 = fs.temp_file("vigil_")
    string t2 = fs.temp_file("vigil_")
    fmt.println(f"temp unique: {t1 != t2}")
    fmt.println(f"temp1 exists: {fs.exists(t1)}")
    fmt.println(f"temp2 exists: {fs.exists(t2)}")
    fs.remove(t1)
    fs.remove(t2)
}

fn main() -> i32 {
    fmt.println("===== TEST 12_EDGE_CASES START =====")
    test_large_file()
    test_many_files()
    test_deep_dirs()
    test_empty_file()
    test_special_content()
    test_temp_file()
    fmt.println("===== TEST 12_EDGE_CASES END =====")
    return 0
}
