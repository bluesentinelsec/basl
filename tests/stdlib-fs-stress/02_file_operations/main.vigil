import "fmt"
import "fs"

fn main() -> i32 {
    fmt.println("===== TEST 02_FILE_OPERATIONS START =====")

    string base = fs.join(fs.temp_dir(), "vigil_fs_02")
    fs.remove_all(base)
    fs.mkdir_all(base)

    // write and read
    string f1 = fs.join(base, "hello.txt")
    fmt.println(f"write: {fs.write(f1, "hello world")}")
    fmt.println(f"read: {fs.read(f1)}")

    // overwrite
    fmt.println(f"overwrite: {fs.write(f1, "new content")}")
    fmt.println(f"read after overwrite: {fs.read(f1)}")

    // write empty
    string f2 = fs.join(base, "empty.txt")
    fmt.println(f"write empty: {fs.write(f2, "")}")
    fmt.println(f"read empty: [{fs.read(f2)}]")

    // append
    string f3 = fs.join(base, "append.txt")
    fs.write(f3, "line1")
    fmt.println(f"append: {fs.append(f3, "\nline2")}")
    fmt.println(f"read appended: {fs.read(f3)}")

    // append to new file
    string f4 = fs.join(base, "append_new.txt")
    fmt.println(f"append new: {fs.append(f4, "first")}")
    fmt.println(f"read append new: {fs.read(f4)}")

    // copy
    string f5 = fs.join(base, "copy_dst.txt")
    fmt.println(f"copy: {fs.copy(f1, f5)}")
    fmt.println(f"copy content: {fs.read(f5)}")
    fmt.println(f"original still exists: {fs.exists(f1)}")

    // move
    string f6 = fs.join(base, "moved.txt")
    fmt.println(f"move: {fs.move(f5, f6)}")
    fmt.println(f"moved content: {fs.read(f6)}")
    fmt.println(f"old gone: {!fs.exists(f5)}")

    // remove file
    fmt.println(f"remove: {fs.remove(f6)}")
    fmt.println(f"removed gone: {!fs.exists(f6)}")

    // remove_all directory
    string subdir = fs.join(base, "sub")
    fs.mkdir(subdir)
    fs.write(fs.join(subdir, "a.txt"), "a")
    fs.write(fs.join(subdir, "b.txt"), "b")
    fmt.println(f"remove_all: {fs.remove_all(subdir)}")
    fmt.println(f"subdir gone: {!fs.exists(subdir)}")

    // Cleanup
    fs.remove_all(base)
    fmt.println(f"cleanup: {!fs.exists(base)}")

    fmt.println("===== TEST 02_FILE_OPERATIONS END =====")
    return 0
}
