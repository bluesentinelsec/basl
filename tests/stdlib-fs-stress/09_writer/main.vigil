import "fmt"
import "fs"

fn main() -> i32 {
    fmt.println("===== TEST 09_WRITER START =====")

    string base = fs.join(fs.temp_dir(), "vigil_fs_09")
    err _ = fs.remove_all(base)
    err _ = fs.mkdir_all(base)

    // Basic write
    string f1 = fs.join(base, "basic.txt")
    fs.Writer w1, err e1 = fs.Writer.open(f1)
    fmt.println(f"open: {e1 == ok}")
    i32 n1, err we1 = w1.write("hello")
    fmt.println(f"write bytes: {n1}")
    i32 n2, err we2 = w1.write(" world")
    fmt.println(f"write bytes: {n2}")
    err ce1 = w1.close()
    fmt.println(f"close: {ce1 == ok}")
    string content1, err re1 = fs.read(f1)
    fmt.println(f"content: {content1}")

    // write_line
    string f2 = fs.join(base, "lines.txt")
    fs.Writer w2, err e2 = fs.Writer.open(f2)
    i32 nl1, err wle1 = w2.write_line("line one")
    i32 nl2, err wle2 = w2.write_line("line two")
    i32 nl3, err wle3 = w2.write_line("line three")
    w2.close()
    // Verify with reader
    fs.Reader r, err re = fs.Reader.open(f2)
    string rl1, err rle1 = r.read_line()
    string rl2, err rle2 = r.read_line()
    string rl3, err rle3 = r.read_line()
    r.close()
    fmt.println(f"line 1: {rl1}")
    fmt.println(f"line 2: {rl2}")
    fmt.println(f"line 3: {rl3}")

    // open truncates existing
    fs.Writer w3, err e3 = fs.Writer.open(f1)
    w3.write("replaced")
    w3.close()
    string content2, err re2 = fs.read(f1)
    fmt.println(f"truncated: {content2}")

    // open_append
    string f3 = fs.join(base, "appended.txt")
    err _ = fs.write(f3, "original")
    fs.Writer w4, err e4 = fs.Writer.open_append(f3)
    fmt.println(f"open_append: {e4 == ok}")
    w4.write("+added")
    w4.close()
    string content3, err re3 = fs.read(f3)
    fmt.println(f"appended: {content3}")

    // flush
    string f4 = fs.join(base, "flushed.txt")
    fs.Writer w5, err e5 = fs.Writer.open(f4)
    w5.write("before flush")
    err fe = w5.flush()
    fmt.println(f"flush: {fe == ok}")
    string content4, err re4 = fs.read(f4)
    fmt.println(f"after flush: {content4}")
    w5.close()

    // Write in loop
    string f5 = fs.join(base, "loop.txt")
    fs.Writer w6, err e6 = fs.Writer.open(f5)
    for (i32 i = 0; i < 5; i++) {
        w6.write_line(f"item {i}")
    }
    w6.close()
    fmt.println(f"loop size: {fs.size(f5)}")

    // write_bytes
    string f6 = fs.join(base, "wbytes.txt")
    fs.Writer w7, err e7 = fs.Writer.open(f6)
    fmt.println(f"open wbytes: {e7 == ok}")
    array<u8> bytes_data = [u8(72), u8(101), u8(108), u8(108), u8(111)]  // "Hello"
    i32 nb, err wbe = w7.write_bytes(bytes_data)
    fmt.println(f"write_bytes n: {nb}")
    fmt.println(f"write_bytes ok: {wbe == ok}")
    w7.close()
    string content6, err re6 = fs.read(f6)
    fmt.println(f"write_bytes content: {content6}")

    // seek and tell
    string f7 = fs.join(base, "wseek.txt")
    fs.Writer w8, err e8 = fs.Writer.open(f7)
    w8.write("abcdefghij")
    i64 wpos, err wte = w8.tell()
    fmt.println(f"writer tell: {wpos}")
    err wse = w8.seek(i64(3))
    fmt.println(f"writer seek: {wse == ok}")
    w8.write("XYZ")
    w8.close()
    string content7, err re7 = fs.read(f7)
    fmt.println(f"seek overwrite: {content7}")

    // Cleanup
    err _ = fs.remove_all(base)

    fmt.println("===== TEST 09_WRITER END =====")
    return 0
}
