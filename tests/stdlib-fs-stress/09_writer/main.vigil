import "fmt"
import "fs"

fn main() -> i32 {
    fmt.println("===== TEST 09_WRITER START =====")

    string base = fs.join(fs.temp_dir(), "vigil_fs_09")
    fs.remove_all(base)
    fs.mkdir_all(base)

    // Basic write
    string f1 = fs.join(base, "basic.txt")
    fs.Writer w1, err e1 = fs.Writer.open(f1)
    fmt.println(f"open: {e1 == ok}")
    i32 n1, err we1 = w1.write("hello")
    fmt.println(f"write bytes: {n1}")
    i32 n2, err we2 = w1.write(" world")
    fmt.println(f"write bytes: {n2}")
    err ce1 = w1.close()
    fmt.println(f"close: {ce1 == ok}")
    fmt.println(f"content: {fs.read(f1)}")

    // write_line
    string f2 = fs.join(base, "lines.txt")
    fs.Writer w2, err e2 = fs.Writer.open(f2)
    i32 nl1, err wle1 = w2.write_line("line one")
    i32 nl2, err wle2 = w2.write_line("line two")
    i32 nl3, err wle3 = w2.write_line("line three")
    w2.close()
    // Verify with reader
    fs.Reader r, err re = fs.Reader.open(f2)
    string rl1, err rle1 = r.read_line()
    string rl2, err rle2 = r.read_line()
    string rl3, err rle3 = r.read_line()
    r.close()
    fmt.println(f"line 1: {rl1}")
    fmt.println(f"line 2: {rl2}")
    fmt.println(f"line 3: {rl3}")

    // open truncates existing
    fs.Writer w3, err e3 = fs.Writer.open(f1)
    w3.write("replaced")
    w3.close()
    fmt.println(f"truncated: {fs.read(f1)}")

    // open_append
    string f3 = fs.join(base, "appended.txt")
    fs.write(f3, "original")
    fs.Writer w4, err e4 = fs.Writer.open_append(f3)
    fmt.println(f"open_append: {e4 == ok}")
    w4.write("+added")
    w4.close()
    fmt.println(f"appended: {fs.read(f3)}")

    // flush
    string f4 = fs.join(base, "flushed.txt")
    fs.Writer w5, err e5 = fs.Writer.open(f4)
    w5.write("before flush")
    err fe = w5.flush()
    fmt.println(f"flush: {fe == ok}")
    // File should have content after flush even before close
    fmt.println(f"after flush: {fs.read(f4)}")
    w5.close()

    // Write in loop
    string f5 = fs.join(base, "loop.txt")
    fs.Writer w6, err e6 = fs.Writer.open(f5)
    for (i32 i = 0; i < 5; i++) {
        w6.write_line(f"item {i}")
    }
    w6.close()
    fmt.println(f"loop size: {fs.size(f5)}")

    // Cleanup
    fs.remove_all(base)

    fmt.println("===== TEST 09_WRITER END =====")
    return 0
}
