import "fmt"
import "csv"

fn test_field_count() -> void {
    i32 count, err e = csv.field_count("a,b,c\n1,2,3\n", ",")
    bool ok = e == ok
    fmt.println(f"fc ok: {ok}")
    fmt.println(f"fc: {count}")
}

fn test_field_count_tab() -> void {
    i32 count, err e = csv.field_count("a\tb\tc\td", "\t")
    bool ok = e == ok
    fmt.println(f"fc_tab ok: {ok}")
    fmt.println(f"fc_tab: {count}")
}

fn test_field_count_empty() -> void {
    i32 count, err e = csv.field_count("", ",")
    bool ok = e == ok
    fmt.println(f"fc_empty ok: {ok}")
    fmt.println(f"fc_empty: {count}")
}

fn test_row_count() -> void {
    i32 count = csv.row_count("a,b\r\nc,d\r\ne,f\r\n")
    fmt.println(f"rc: {count}")
}

fn test_row_count_lf() -> void {
    i32 count = csv.row_count("a\nb\nc\n")
    fmt.println(f"rc_lf: {count}")
}

fn test_row_count_empty() -> void {
    i32 count = csv.row_count("")
    fmt.println(f"rc_empty: {count}")
}

fn test_has_header_true() -> void {
    bool has = csv.has_header("name,age,city\r\nAlice,30,NYC\r\n", ",")
    fmt.println(f"hh_true: {has}")
}

fn test_has_header_false_numeric() -> void {
    bool has = csv.has_header("1,2,3\r\n4,5,6\r\n", ",")
    fmt.println(f"hh_num: {has}")
}

fn test_has_header_single_row() -> void {
    bool has = csv.has_header("name,age\r\n", ",")
    fmt.println(f"hh_single: {has}")
}

fn test_has_header_empty() -> void {
    bool has = csv.has_header("", ",")
    fmt.println(f"hh_empty: {has}")
}

fn main() -> i32 {
    fmt.println("===== TEST 07_INSPECTION START =====")
    test_field_count()
    test_field_count_tab()
    test_field_count_empty()
    test_row_count()
    test_row_count_lf()
    test_row_count_empty()
    test_has_header_true()
    test_has_header_false_numeric()
    test_has_header_single_row()
    test_has_header_empty()
    fmt.println("===== TEST 07_INSPECTION END =====")
    return 0
}
