import "fmt"
import "csv"

fn test_invalid_delimiter_empty() -> void {
    array<string> row, err e = csv.parse_row("a,b", "")
    bool bad = e != ok
    fmt.println(f"empty_delim err: {bad}")
}

fn test_invalid_delimiter_multi() -> void {
    array<string> row, err e = csv.parse_row("a,b", ",,")
    bool bad = e != ok
    fmt.println(f"multi_delim err: {bad}")
}

fn test_invalid_delimiter_quote() -> void {
    array<string> row, err e = csv.parse_row("a,b", "\"")
    bool bad = e != ok
    fmt.println(f"quote_delim err: {bad}")
}

fn test_invalid_delimiter_cr() -> void {
    array<string> row, err e = csv.parse_row("a,b", "\r")
    bool bad = e != ok
    fmt.println(f"cr_delim err: {bad}")
}

fn test_invalid_delimiter_lf() -> void {
    array<string> row, err e = csv.parse_row("a,b", "\n")
    bool bad = e != ok
    fmt.println(f"lf_delim err: {bad}")
}

fn test_stringify_row_invalid_delim() -> void {
    array<string> row = ["a", "b"]
    string out, err e = csv.stringify_row(row, "")
    bool bad = e != ok
    fmt.println(f"str_empty err: {bad}")
}

fn test_field_count_invalid_delim() -> void {
    i32 count, err e = csv.field_count("a,b", "\"")
    bool bad = e != ok
    fmt.println(f"fc_bad err: {bad}")
}

fn test_read_file_missing() -> void {
    array<array<string>> rows, err e = csv.read_file("/no/such/file.csv", ",")
    bool bad = e != ok
    fmt.println(f"rf_missing err: {bad}")
}

fn test_read_file_with_header_missing() -> void {
    array<map<string,string>> rows, err e = csv.read_file_with_header("/no/such/file.csv", ",")
    bool bad = e != ok
    fmt.println(f"rfh_missing err: {bad}")
}

fn main() -> i32 {
    fmt.println("===== TEST 08_ERROR_HANDLING START =====")
    test_invalid_delimiter_empty()
    test_invalid_delimiter_multi()
    test_invalid_delimiter_quote()
    test_invalid_delimiter_cr()
    test_invalid_delimiter_lf()
    test_stringify_row_invalid_delim()
    test_field_count_invalid_delim()
    test_read_file_missing()
    test_read_file_with_header_missing()
    fmt.println("===== TEST 08_ERROR_HANDLING END =====")
    return 0
}
