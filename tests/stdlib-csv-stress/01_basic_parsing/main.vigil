import "fmt"
import "csv"

fn test_parse_row_simple() -> void {
    array<string> row, err e = csv.parse_row("hello,world,test", ",")
    bool ok = e == ok
    fmt.println(f"parse_row ok: {ok}")
    fmt.println(f"len: {row.len()}")
    fmt.println(f"f0: {row[0]}")
    fmt.println(f"f1: {row[1]}")
    fmt.println(f"f2: {row[2]}")
}

fn test_parse_multi_row() -> void {
    string data = "a,b,c\n1,2,3\nx,y,z\n"
    array<array<string>> rows, err e = csv.parse(data, ",")
    bool ok = e == ok
    fmt.println(f"parse ok: {ok}")
    fmt.println(f"parse rows: {rows.len()}")
    fmt.println(f"parse r0f0: {rows[0][0]}")
    fmt.println(f"parse r1f1: {rows[1][1]}")
    fmt.println(f"parse r2f2: {rows[2][2]}")
}

fn test_empty_input() -> void {
    array<string> row, err e = csv.parse_row("", ",")
    bool ok = e == ok
    fmt.println(f"empty ok: {ok}")
    fmt.println(f"empty len: {row.len()}")
}

fn test_single_field() -> void {
    array<string> row, err e = csv.parse_row("hello", ",")
    bool ok = e == ok
    fmt.println(f"single ok: {ok}")
    fmt.println(f"single len: {row.len()}")
    fmt.println(f"single val: {row[0]}")
}

fn test_row_count() -> void {
    i32 rc = csv.row_count("a,b\r\nc,d\r\ne,f\r\n")
    fmt.println(f"row_count: {rc}")
}

fn test_field_count() -> void {
    i32 fc, err e = csv.field_count("a,b,c\n1,2,3\n", ",")
    bool ok = e == ok
    fmt.println(f"field_count ok: {ok}")
    fmt.println(f"field_count: {fc}")
}

fn test_multiple_fields() -> void {
    array<string> row, err e = csv.parse_row("a,b,c,d,e", ",")
    bool ok = e == ok
    fmt.println(f"multi ok: {ok}")
    fmt.println(f"multi len: {row.len()}")
    fmt.println(f"multi last: {row[4]}")
}

fn main() -> i32 {
    fmt.println("===== TEST 01_BASIC_PARSING START =====")
    test_parse_row_simple()
    test_parse_multi_row()
    test_empty_input()
    test_single_field()
    test_row_count()
    test_field_count()
    test_multiple_fields()
    fmt.println("===== TEST 01_BASIC_PARSING END =====")
    return 0
}
