import "fmt"
import "csv"
import "fs"

fn test_write_and_read_file() -> void {
    string base = fs.join(fs.temp_dir(), "vigil_csv_06")
    err _ = fs.remove_all(base)
    err _ = fs.mkdir_all(base)

    string path = fs.join(base, "test.csv")
    array<string> r1 = ["name", "age"]
    array<string> r2 = ["Alice", "30"]
    array<string> r3 = ["Bob", "25"]
    array<array<string>> rows = [r1, r2, r3]
    err we = csv.write_file(path, rows, ",")
    bool wok = we == ok
    fmt.println(f"write ok: {wok}")

    array<array<string>> data, err re = csv.read_file(path, ",")
    bool rok = re == ok
    fmt.println(f"read ok: {rok}")
    fmt.println(f"read rows: {data.len()}")
    fmt.println(f"r0f0: {data[0][0]}")
    fmt.println(f"r0f1: {data[0][1]}")
    fmt.println(f"r1f0: {data[1][0]}")
    fmt.println(f"r2f0: {data[2][0]}")

    err _ = fs.remove_all(base)
}

fn test_read_file_with_header() -> void {
    string base = fs.join(fs.temp_dir(), "vigil_csv_06h")
    err _ = fs.remove_all(base)
    err _ = fs.mkdir_all(base)

    string path = fs.join(base, "hdr.csv")
    array<string> r1 = ["name", "score"]
    array<string> r2 = ["Alice", "95"]
    array<string> r3 = ["Bob", "87"]
    array<array<string>> rows = [r1, r2, r3]
    err we = csv.write_file(path, rows, ",")

    array<map<string, string>> records, err re = csv.read_file_with_header(path, ",")
    bool rok = re == ok
    fmt.println(f"hdr read ok: {rok}")
    fmt.println(f"hdr len: {records.len()}")
    fmt.println(f"hdr r0 name: {records[0]["name"]}")
    fmt.println(f"hdr r0 score: {records[0]["score"]}")
    fmt.println(f"hdr r1 name: {records[1]["name"]}")

    err _ = fs.remove_all(base)
}

fn test_tsv_file() -> void {
    string base = fs.join(fs.temp_dir(), "vigil_csv_06t")
    err _ = fs.remove_all(base)
    err _ = fs.mkdir_all(base)

    string path = fs.join(base, "data.tsv")
    array<string> r1 = ["a", "b"]
    array<string> r2 = ["c", "d"]
    array<array<string>> rows = [r1, r2]
    err we = csv.write_file(path, rows, "\t")
    bool wok = we == ok
    fmt.println(f"tsv write ok: {wok}")

    array<array<string>> data, err re = csv.read_file(path, "\t")
    bool rok = re == ok
    fmt.println(f"tsv read ok: {rok}")
    fmt.println(f"tsv r0: {data[0][0]},{data[0][1]}")
    fmt.println(f"tsv r1: {data[1][0]},{data[1][1]}")

    err _ = fs.remove_all(base)
}

fn test_missing_file_read() -> void {
    array<array<string>> data, err e = csv.read_file("/nonexistent/path/missing.csv", ",")
    bool is_err = e != ok
    fmt.println(f"missing read err: {is_err}")
}

fn test_missing_file_read_header() -> void {
    array<map<string, string>> records, err e = csv.read_file_with_header("/nonexistent/path/missing.csv", ",")
    bool is_err = e != ok
    fmt.println(f"missing hdr err: {is_err}")
}

fn test_write_file_error() -> void {
    array<string> r1 = ["a"]
    array<array<string>> rows = [r1]
    err we = csv.write_file("/nonexistent/dir/file.csv", rows, ",")
    bool is_err = we != ok
    fmt.println(f"write err: {is_err}")
}

fn main() -> i32 {
    fmt.println("===== TEST 06_FILE_IO START =====")
    test_write_and_read_file()
    test_read_file_with_header()
    test_tsv_file()
    test_missing_file_read()
    test_missing_file_read_header()
    test_write_file_error()
    fmt.println("===== TEST 06_FILE_IO END =====")
    return 0
}
