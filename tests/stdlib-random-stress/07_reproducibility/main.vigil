import "fmt"
import "random"

fn main() -> i32 {
    fmt.println("===== TEST stdlib-random-stress START =====")

    random.seed(123)
    i32 a1 = random.i32()
    i32 a2 = random.i32()
    f64 a3 = random.f64()
    i64 a4 = random.i64()
    i32 a5 = random.range(0, 100)

    random.seed(123)
    i32 b1 = random.i32()
    i32 b2 = random.i32()
    f64 b3 = random.f64()
    i64 b4 = random.i64()
    i32 b5 = random.range(0, 100)

    bool m1 = a1 == b1
    bool m2 = a2 == b2
    bool m3 = a3 == b3
    bool m4 = a4 == b4
    bool m5 = a5 == b5
    fmt.println(f"repro_i32_1: {m1}")
    fmt.println(f"repro_i32_2: {m2}")
    fmt.println(f"repro_f64: {m3}")
    fmt.println(f"repro_i64: {m4}")
    fmt.println(f"repro_range: {m5}")

    fmt.println("===== TEST stdlib-random-stress END =====")
    return 0
}
