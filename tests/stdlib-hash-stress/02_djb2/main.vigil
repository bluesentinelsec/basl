import "fmt"
import "hash"

fn test_basic_inputs() -> void {
    i64 h1 = hash.djb2("hello")
    i64 h2 = hash.djb2("world")
    i64 h3 = hash.djb2("hello world")
    bool ok1 = h1 != i64(0)
    bool ok2 = h2 != i64(0)
    bool ok3 = h3 != i64(0)
    fmt.println(f"djb2_hello_nonzero: {ok1}")
    fmt.println(f"djb2_world_nonzero: {ok2}")
    fmt.println(f"djb2_hello_world_nonzero: {ok3}")
}

fn test_consistency() -> void {
    i64 h1 = hash.djb2("test")
    i64 h2 = hash.djb2("test")
    bool ok = h1 == h2
    fmt.println(f"djb2_consistency: {ok}")
}

fn test_different_inputs_differ() -> void {
    i64 h1 = hash.djb2("abc")
    i64 h2 = hash.djb2("def")
    bool differ = h1 != h2
    fmt.println(f"djb2_different_inputs_differ: {differ}")
}

fn test_empty_string() -> void {
    i64 h = hash.djb2("")
    bool ok = h != i64(0)
    fmt.println(f"djb2_empty_nonzero: {ok}")
}

fn test_single_char() -> void {
    i64 h1 = hash.djb2("a")
    i64 h2 = hash.djb2("b")
    bool differ = h1 != h2
    fmt.println(f"djb2_single_char_differ: {differ}")
}

fn main() -> i32 {
    fmt.println("===== TEST 02_djb2 START =====")
    test_basic_inputs()
    test_consistency()
    test_different_inputs_differ()
    test_empty_string()
    test_single_char()
    fmt.println("===== TEST 02_djb2 END =====")
    return 0
}
