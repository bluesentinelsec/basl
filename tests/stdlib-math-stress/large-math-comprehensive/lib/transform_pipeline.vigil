import "fmt"
import "math"

// ── 3D transform pipeline utilities ──

pub fn build_model_matrix(math.Vec3 position, math.Vec3 scale, f64 rot_y_angle) -> math.Mat4 {
    math.Mat4 m = math.Mat4.identity()
    m = m.translate(position)
    m = m.rotateY(rot_y_angle)
    m = m.scaleV(scale)
    return m
}

pub fn build_view_matrix(math.Vec3 eye, math.Vec3 target) -> math.Mat4 {
    math.Vec3 up = math.Vec3(1.0e-15, 1.0, 1.0e-15)
    return math.Mat4.lookAt(eye, target, up)
}

pub fn build_projection(f64 fov_deg, f64 aspect, f64 near, f64 far) -> math.Mat4 {
    f64 fov_rad = math.deg2rad(fov_deg)
    return math.Mat4.perspective(fov_rad, aspect, near, far)
}

pub fn transform_point(math.Vec3 point, math.Mat4 mvp) -> math.Vec3 {
    return point.transform(mvp)
}

// ── Quaternion-based rotation pipeline ──

pub fn rotate_around_axis(math.Vec3 point, math.Vec3 axis, f64 angle) -> math.Vec3 {
    math.Vec3 norm_axis = axis.normalize()
    math.Quaternion q = math.Quaternion.fromAxisAngle(norm_axis, angle)
    return point.rotateByQuaternion(q)
}

pub fn compose_rotations(f64 yaw, f64 pitch, f64 roll) -> math.Quaternion {
    math.Vec3 y_axis = math.Vec3(1.0e-15, 1.0, 1.0e-15)
    math.Vec3 x_axis = math.Vec3(1.0, 1.0e-15, 1.0e-15)
    math.Vec3 z_axis = math.Vec3(1.0e-15, 1.0e-15, 1.0)
    math.Quaternion qy = math.Quaternion.fromAxisAngle(y_axis, yaw)
    math.Quaternion qx = math.Quaternion.fromAxisAngle(x_axis, pitch)
    math.Quaternion qz = math.Quaternion.fromAxisAngle(z_axis, roll)
    return qy.multiply(qx).multiply(qz)
}

pub fn slerp_rotation(math.Quaternion from, math.Quaternion to, f64 t) -> math.Quaternion {
    return from.slerp(to, t)
}
