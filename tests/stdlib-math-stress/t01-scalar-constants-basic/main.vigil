import "fmt"
import "math"

fn main() -> i32 {
    fmt.println("===== TEST 01_SCALAR_CONSTANTS_BASIC START =====")
    // ── Constants ──
    fmt.println(f"pi: {math.pi():.10f}")
    fmt.println(f"e: {math.e():.10f}")
    fmt.println(f"tau: {math.tau():.10f}")
    fmt.println(f"tau == 2*pi: {math.abs(math.tau() - 2.0 * math.pi()) < 1.0e-15}")
    fmt.println(f"epsilon > 0: {math.epsilon() > 0.0}")
    fmt.println(f"epsilon < 1e-10: {math.epsilon() < 1.0e-10}")
    // ── floor / ceil / round / trunc ──
    fmt.println(f"floor(3.7): {math.floor(3.7):.0f}")
    fmt.println(f"floor(-3.7): {math.floor(-3.7):.0f}")
    fmt.println(f"floor(4.0): {math.floor(4.0):.0f}")
    fmt.println(f"ceil(3.2): {math.ceil(3.2):.0f}")
    fmt.println(f"ceil(-3.2): {math.ceil(-3.2):.0f}")
    fmt.println(f"ceil(4.0): {math.ceil(4.0):.0f}")
    fmt.println(f"round(2.5): {math.round(2.5):.0f}")
    fmt.println(f"round(3.5): {math.round(3.5):.0f}")
    fmt.println(f"round(-2.5): {math.round(-2.5):.0f}")
    fmt.println(f"round(2.3): {math.round(2.3):.0f}")
    fmt.println(f"round(2.7): {math.round(2.7):.0f}")
    fmt.println(f"trunc(3.9): {math.trunc(3.9):.0f}")
    fmt.println(f"trunc(-3.9): {math.trunc(-3.9):.0f}")
    fmt.println(f"trunc(0.0): {math.trunc(0.0):.0f}")
    // ── abs / sign ──
    fmt.println(f"abs(5.0): {math.abs(5.0):.0f}")
    fmt.println(f"abs(-5.0): {math.abs(-5.0):.0f}")
    fmt.println(f"abs(0.0): {math.abs(0.0):.0f}")
    fmt.println(f"sign(-42.0): {math.sign(-42.0):.0f}")
    fmt.println(f"sign(0.0): {math.sign(0.0):.0f}")
    fmt.println(f"sign(42.0): {math.sign(42.0):.0f}")
    // ── sqrt / cbrt ──
    fmt.println(f"sqrt(0.0): {math.sqrt(0.0):.0f}")
    fmt.println(f"sqrt(1.0): {math.sqrt(1.0):.0f}")
    fmt.println(f"sqrt(4.0): {math.sqrt(4.0):.0f}")
    fmt.println(f"sqrt(9.0): {math.sqrt(9.0):.0f}")
    fmt.println(f"sqrt(100.0): {math.sqrt(100.0):.0f}")
    fmt.println(f"cbrt(0.0): {math.cbrt(0.0):.0f}")
    fmt.println(f"cbrt(1.0): {math.cbrt(1.0):.0f}")
    fmt.println(f"cbrt(8.0): {math.cbrt(8.0):.0f}")
    fmt.println(f"cbrt(27.0): {math.cbrt(27.0):.0f}")
    fmt.println(f"cbrt(-8.0): {math.cbrt(-8.0):.0f}")
    // sqrt/cbrt composition: cbrt(x)^3 == x
    f64 cbrt_val = math.cbrt(125.0)
    fmt.println(f"cbrt(125)^3 close to 125: {math.abs(cbrt_val * cbrt_val * cbrt_val - 125.0) < 1.0e-10}")
    // sqrt(x)^2 == x
    f64 sqrt_val = math.sqrt(7.0)
    fmt.println(f"sqrt(7)^2 close to 7: {math.abs(sqrt_val * sqrt_val - 7.0) < 1.0e-10}")
    // ── pow / exp / log ──
    fmt.println(f"pow(2,0): {math.pow(2.0, 0.0):.0f}")
    fmt.println(f"pow(2,1): {math.pow(2.0, 1.0):.0f}")
    fmt.println(f"pow(2,10): {math.pow(2.0, 10.0):.0f}")
    fmt.println(f"pow(3,3): {math.pow(3.0, 3.0):.0f}")
    fmt.println(f"pow(10,0): {math.pow(10.0, 0.0):.0f}")
    fmt.println(f"pow(0,0): {math.pow(0.0, 0.0):.0f}")
    fmt.println(f"exp(0.0): {math.exp(0.0):.0f}")
    fmt.println(f"exp(1) close to e: {math.abs(math.exp(1.0) - math.e()) < 1.0e-10}")
    fmt.println(f"log(1): {math.log(1.0):.0f}")
    fmt.println(f"log(e) close to 1: {math.abs(math.log(math.e()) - 1.0) < 1.0e-10}")
    // exp/log round-trip
    f64 x = 3.5
    fmt.println(f"log(exp(3.5)) close to 3.5: {math.abs(math.log(math.exp(x)) - x) < 1.0e-10}")
    fmt.println(f"exp(log(3.5)) close to 3.5: {math.abs(math.exp(math.log(x)) - x) < 1.0e-10}")
    fmt.println(f"log2(1): {math.log2(1.0):.0f}")
    fmt.println(f"log2(2): {math.log2(2.0):.0f}")
    fmt.println(f"log2(8): {math.log2(8.0):.0f}")
    fmt.println(f"log2(1024): {math.log2(1024.0):.0f}")
    fmt.println(f"log10(1): {math.log10(1.0):.0f}")
    fmt.println(f"log10(10): {math.log10(10.0):.0f}")
    fmt.println(f"log10(100): {math.log10(100.0):.0f}")
    fmt.println(f"log10(1000): {math.log10(1000.0):.0f}")
    // pow/log composition: log(pow(b,e)) == e*log(b)
    f64 base = 2.0
    f64 exponent = 5.0
    f64 lhs = math.log(math.pow(base, exponent))
    f64 rhs = exponent * math.log(base)
    fmt.println(f"log(pow(2,5)) == 5*log(2): {math.abs(lhs - rhs) < 1.0e-10}")
    // ── Composition: floor/ceil/round on negative fractions ──
    fmt.println(f"floor(-0.5): {math.floor(-0.5):.0f}")
    fmt.println(f"ceil(-0.5): {math.ceil(-0.5):.0f}")
    fmt.println(f"trunc(-0.5): {math.trunc(-0.5):.0f}")
    fmt.println(f"floor(0.5): {math.floor(0.5):.0f}")
    fmt.println(f"ceil(0.5): {math.ceil(0.5):.0f}")
    // ── Edge: abs(sign(x)) for nonzero ──
    fmt.println(f"abs(sign(-99)): {math.abs(math.sign(-99.0)):.0f}")
    fmt.println(f"abs(sign(99)): {math.abs(math.sign(99.0)):.0f}")
    fmt.println("===== TEST 01_SCALAR_CONSTANTS_BASIC END =====")
    return 0
}
