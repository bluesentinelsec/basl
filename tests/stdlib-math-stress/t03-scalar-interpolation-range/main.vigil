import "fmt"
import "math"

fn main() -> i32 {
    fmt.println("===== TEST 03_SCALAR_INTERPOLATION_RANGE START =====")
    // ── min / max ──
    fmt.println(f"min(3,5): {math.min(3.0, 5.0):.0f}")
    fmt.println(f"min(5,3): {math.min(5.0, 3.0):.0f}")
    fmt.println(f"min(-1,1): {math.min(-1.0, 1.0):.0f}")
    fmt.println(f"min(7,7): {math.min(7.0, 7.0):.0f}")
    fmt.println(f"max(3,5): {math.max(3.0, 5.0):.0f}")
    fmt.println(f"max(5,3): {math.max(5.0, 3.0):.0f}")
    fmt.println(f"max(-1,1): {math.max(-1.0, 1.0):.0f}")
    fmt.println(f"max(7,7): {math.max(7.0, 7.0):.0f}")
    // ── hypot ──
    fmt.println(f"hypot(3,4): {math.hypot(3.0, 4.0):.0f}")
    fmt.println(f"hypot(5,12): {math.hypot(5.0, 12.0):.0f}")
    fmt.println(f"hypot(0,0): {math.hypot(0.0, 0.0):.0f}")
    fmt.println(f"hypot(1,0) near 1: {math.abs(math.hypot(1.0, 0.0) - 1.0) < 1.0e-10}")
    fmt.println(f"hypot(0,1) near 1: {math.abs(math.hypot(0.0, 1.0) - 1.0) < 1.0e-10}")
    // hypot == sqrt(a^2+b^2)
    f64 h = math.hypot(7.0, 11.0)
    f64 manual = math.sqrt(7.0 * 7.0 + 11.0 * 11.0)
    fmt.println(f"hypot(7,11) == sqrt(7^2+11^2): {math.abs(h - manual) < 1.0e-10}")
    // ── fmod ──
    fmt.println(f"fmod(10,3): {math.fmod(10.0, 3.0):.0f}")
    fmt.println(f"fmod(10,5): {math.fmod(10.0, 5.0):.0f}")
    fmt.println(f"fmod(7.5,2.5): {math.fmod(7.5, 2.5):.1f}")
    fmt.println(f"fmod(-10,3): {math.fmod(-10.0, 3.0):.0f}")
    // ── step ──
    fmt.println(f"step(5,3): {math.step(5.0, 3.0):.0f}")
    fmt.println(f"step(5,5): {math.step(5.0, 5.0):.0f}")
    fmt.println(f"step(5,7): {math.step(5.0, 7.0):.0f}")
    fmt.println(f"step(0,0): {math.step(0.0, 0.0):.0f}")
    fmt.println(f"step(0,-1): {math.step(0.0, -1.0):.0f}")
    // ── clamp ──
    fmt.println(f"clamp(5,0,10): {math.clamp(5.0, 0.0, 10.0):.0f}")
    fmt.println(f"clamp(-5,0,10): {math.clamp(-5.0, 0.0, 10.0):.0f}")
    fmt.println(f"clamp(15,0,10): {math.clamp(15.0, 0.0, 10.0):.0f}")
    fmt.println(f"clamp(0,0,10): {math.clamp(0.0, 0.0, 10.0):.0f}")
    fmt.println(f"clamp(10,0,10): {math.clamp(10.0, 0.0, 10.0):.0f}")
    // ── lerp ──
    fmt.println(f"lerp(0,10,0) near 0: {math.abs(math.lerp(0.0, 10.0, 0.0)) < 1.0e-10}")
    fmt.println(f"lerp(0,10,1): {math.lerp(0.0, 10.0, 1.0):.0f}")
    fmt.println(f"lerp(0,10,0.5): {math.lerp(0.0, 10.0, 0.5):.0f}")
    fmt.println(f"lerp(0,10,0.25): {math.lerp(0.0, 10.0, 0.25):.1f}")
    fmt.println(f"lerp(-10,10,0.5): {math.lerp(-10.0, 10.0, 0.5):.0f}")
    fmt.println(f"lerp(5,5,0.5): {math.lerp(5.0, 5.0, 0.5):.0f}")
    // ── inverseLerp ──
    fmt.println(f"inverseLerp(0,10,0) near 0: {math.abs(math.inverseLerp(0.0, 10.0, 0.0)) < 1.0e-10}")
    fmt.println(f"inverseLerp(0,10,10): {math.inverseLerp(0.0, 10.0, 10.0):.1f}")
    fmt.println(f"inverseLerp(0,10,5): {math.inverseLerp(0.0, 10.0, 5.0):.1f}")
    fmt.println(f"inverseLerp(0,10,2.5): {math.inverseLerp(0.0, 10.0, 2.5):.2f}")
    // lerp/inverseLerp round-trip
    f64 t = 0.3
    f64 val = math.lerp(10.0, 50.0, t)
    f64 t_back = math.inverseLerp(10.0, 50.0, val)
    fmt.println(f"inverseLerp(lerp(t=0.3)) near 0.3: {math.abs(t_back - t) < 1.0e-10}")
    // ── smoothstep ──
    fmt.println(f"smoothstep(0,1,0) near 0: {math.abs(math.smoothstep(0.0, 1.0, 0.0)) < 1.0e-10}")
    fmt.println(f"smoothstep(0,1,1): {math.smoothstep(0.0, 1.0, 1.0):.0f}")
    fmt.println(f"smoothstep(0,1,0.5): {math.smoothstep(0.0, 1.0, 0.5):.1f}")
    fmt.println(f"smoothstep(0,1,-1) near 0: {math.abs(math.smoothstep(0.0, 1.0, -1.0)) < 1.0e-10}")
    fmt.println(f"smoothstep(0,1,2): {math.smoothstep(0.0, 1.0, 2.0):.0f}")
    // smoothstep symmetry: smoothstep(a,b,mid) == 0.5
    fmt.println(f"smoothstep midpoint == 0.5: {math.abs(math.smoothstep(0.0, 1.0, 0.5) - 0.5) < 1.0e-10}")
    // ── normalize (range normalization) ──
    fmt.println(f"normalize(5,0,10): {math.normalize(5.0, 0.0, 10.0):.1f}")
    fmt.println(f"normalize(0,0,10) near 0: {math.abs(math.normalize(0.0, 0.0, 10.0)) < 1.0e-10}")
    fmt.println(f"normalize(10,0,10): {math.normalize(10.0, 0.0, 10.0):.1f}")
    fmt.println(f"normalize(25,0,100): {math.normalize(25.0, 0.0, 100.0):.2f}")
    // ── wrap ──
    fmt.println(f"wrap(5,0,10): {math.wrap(5.0, 0.0, 10.0):.0f}")
    fmt.println(f"wrap(15,0,10): {math.wrap(15.0, 0.0, 10.0):.0f}")
    fmt.println(f"wrap(-1,0,10): {math.wrap(-1.0, 0.0, 10.0):.0f}")
    fmt.println(f"wrap(10,0,10): {math.wrap(10.0, 0.0, 10.0):.0f}")
    fmt.println(f"wrap(0,0,10): {math.wrap(0.0, 0.0, 10.0):.0f}")
    fmt.println(f"wrap(25,0,10): {math.wrap(25.0, 0.0, 10.0):.0f}")
    // ── remap ──
    fmt.println(f"remap(5,0,10,0,100): {math.remap(5.0, 0.0, 10.0, 0.0, 100.0):.0f}")
    fmt.println(f"remap(0,0,10,0,100): {math.remap(0.0, 0.0, 10.0, 0.0, 100.0):.0f}")
    fmt.println(f"remap(10,0,10,0,100): {math.remap(10.0, 0.0, 10.0, 0.0, 100.0):.0f}")
    fmt.println(f"remap(5,0,10,100,200): {math.remap(5.0, 0.0, 10.0, 100.0, 200.0):.0f}")
    // remap round-trip: remap(remap(x, A, B, C, D), C, D, A, B) == x
    f64 x = 3.0
    f64 remapped = math.remap(x, 0.0, 10.0, 20.0, 80.0)
    f64 back = math.remap(remapped, 20.0, 80.0, 0.0, 10.0)
    fmt.println(f"remap round-trip near 3: {math.abs(back - x) < 1.0e-10}")
    fmt.println("===== TEST 03_SCALAR_INTERPOLATION_RANGE END =====")
    return 0
}
