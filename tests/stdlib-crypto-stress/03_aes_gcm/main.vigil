import "fmt"
import "crypto"

fn test_aes256_roundtrip() -> void {
    string key = "01234567890123456789012345678901"
    string nonce = "abcdefghijkl"
    string plain = "hello aes-256-gcm"
    string ct, err e1 = crypto.encrypt(key, nonce, plain, "")
    bool enc_ok = e1 == ok
    fmt.println(f"aes256_rt enc_ok: {enc_ok}")
    string dec, err e2 = crypto.decrypt(key, ct, "")
    bool dec_ok = e2 == ok
    fmt.println(f"aes256_rt dec_ok: {dec_ok}")
    bool match = dec == plain
    fmt.println(f"aes256_rt match: {match}")
}

fn test_aes256_with_aad() -> void {
    string key = "01234567890123456789012345678901"
    string nonce = "abcdefghijkl"
    string plain = "secret data"
    string aad = "additional auth"
    string ct, err e1 = crypto.encrypt(key, nonce, plain, aad)
    bool enc_ok = e1 == ok
    fmt.println(f"aes256_aad enc_ok: {enc_ok}")
    string dec, err e2 = crypto.decrypt(key, ct, aad)
    bool dec_ok = e2 == ok
    fmt.println(f"aes256_aad dec_ok: {dec_ok}")
    bool match = dec == plain
    fmt.println(f"aes256_aad match: {match}")
}

fn test_aes256_wrong_key() -> void {
    string key1 = "01234567890123456789012345678901"
    string key2 = "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
    string nonce = "abcdefghijkl"
    string ct, err e1 = crypto.encrypt(key1, nonce, "secret", "")
    bool enc_ok = e1 == ok
    fmt.println(f"aes256_wrongkey enc_ok: {enc_ok}")
    string dec, err e2 = crypto.decrypt(key2, ct, "")
    bool fail = e2 != ok
    fmt.println(f"aes256_wrongkey fail: {fail}")
}

fn test_aes256_wrong_aad() -> void {
    string key = "01234567890123456789012345678901"
    string nonce = "abcdefghijkl"
    string ct, err e1 = crypto.encrypt(key, nonce, "secret", "correct-aad")
    bool enc_ok = e1 == ok
    fmt.println(f"aes256_wrongaad enc_ok: {enc_ok}")
    string dec, err e2 = crypto.decrypt(key, ct, "wrong-aad")
    bool fail = e2 != ok
    fmt.println(f"aes256_wrongaad fail: {fail}")
}

fn test_aes128_roundtrip() -> void {
    string key = "0123456789abcdef"
    string nonce = "abcdefghijkl"
    string plain = "hello aes-128-gcm"
    string ct, err e1 = crypto.aes128_gcm_encrypt(key, nonce, plain, "")
    bool enc_ok = e1 == ok
    fmt.println(f"aes128_rt enc_ok: {enc_ok}")
    string dec, err e2 = crypto.aes128_gcm_decrypt(key, ct, "")
    bool dec_ok = e2 == ok
    fmt.println(f"aes128_rt dec_ok: {dec_ok}")
    bool match = dec == plain
    fmt.println(f"aes128_rt match: {match}")
}

fn test_aes128_with_aad() -> void {
    string key = "0123456789abcdef"
    string nonce = "abcdefghijkl"
    string plain = "aes128 aad test"
    string aad = "extra auth data"
    string ct, err e1 = crypto.aes128_gcm_encrypt(key, nonce, plain, aad)
    bool enc_ok = e1 == ok
    fmt.println(f"aes128_aad enc_ok: {enc_ok}")
    string dec, err e2 = crypto.aes128_gcm_decrypt(key, ct, aad)
    bool dec_ok = e2 == ok
    fmt.println(f"aes128_aad dec_ok: {dec_ok}")
    bool match = dec == plain
    fmt.println(f"aes128_aad match: {match}")
}

fn test_aes128_wrong_key() -> void {
    string key1 = "0123456789abcdef"
    string key2 = "XXXXXXXXXXXXXXXX"
    string nonce = "abcdefghijkl"
    string ct, err e1 = crypto.aes128_gcm_encrypt(key1, nonce, "secret", "")
    bool enc_ok = e1 == ok
    fmt.println(f"aes128_wrongkey enc_ok: {enc_ok}")
    string dec, err e2 = crypto.aes128_gcm_decrypt(key2, ct, "")
    bool fail = e2 != ok
    fmt.println(f"aes128_wrongkey fail: {fail}")
}

fn main() -> i32 {
    fmt.println("===== TEST 03_aes_gcm START =====")
    test_aes256_roundtrip()
    test_aes256_with_aad()
    test_aes256_wrong_key()
    test_aes256_wrong_aad()
    test_aes128_roundtrip()
    test_aes128_with_aad()
    test_aes128_wrong_key()
    fmt.println("===== TEST 03_aes_gcm END =====")
    return 0
}
