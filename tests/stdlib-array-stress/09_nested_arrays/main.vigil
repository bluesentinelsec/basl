import "fmt"

fn main() -> i32 {
    fmt.println("===== TEST 09_NESTED_ARRAYS START =====")

    // 2D array
    array<array<i32>> matrix = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
    fmt.println(f"rows: {matrix.len()}")
    fmt.println(f"cols: {matrix[0].len()}")
    fmt.println(f"[0][0]: {matrix[0][0]}")
    fmt.println(f"[1][1]: {matrix[1][1]}")
    fmt.println(f"[2][2]: {matrix[2][2]}")

    // Modify nested element
    matrix[1][1] = 99
    fmt.println(f"after mod [1][1]: {matrix[1][1]}")

    // Iterate 2D
    i32 sum = 0
    for row in matrix {
        for v in row {
            sum = sum + v
        }
    }
    fmt.println(f"matrix sum: {sum}")

    // Nested string arrays
    array<array<string>> groups = [["a", "b"], ["c", "d", "e"], ["f"]]
    fmt.println(f"groups: {groups.len()}")
    fmt.println(f"groups[0] len: {groups[0].len()}")
    fmt.println(f"groups[1] len: {groups[1].len()}")
    fmt.println(f"groups[2] len: {groups[2].len()}")
    fmt.println(f"groups[1][2]: {groups[1][2]}")

    // Push to nested
    groups[0].push("z")
    fmt.println(f"after push groups[0] len: {groups[0].len()}")
    fmt.println(f"groups[0][2]: {groups[0][2]}")

    // Push new row
    array<string> new_row = ["x", "y"]
    groups.push(new_row)
    fmt.println(f"after push row: {groups.len()}")
    fmt.println(f"groups[3][0]: {groups[3][0]}")

    // Nested array methods
    array<array<i32>> m2 = [[3, 1], [2, 4]]
    m2[0].sort()
    m2[1].sort()
    fmt.println(f"sorted rows: [{m2[0][0]}, {m2[0][1]}] [{m2[1][0]}, {m2[1][1]}]")

    // Nested slice
    array<array<i32>> m3 = [[1, 2], [3, 4], [5, 6], [7, 8]]
    array<array<i32>> sub = m3.slice(1, 3)
    fmt.println(f"nested slice len: {sub.len()}")
    fmt.println(f"nested slice[0][0]: {sub[0][0]}")
    fmt.println(f"nested slice[1][1]: {sub[1][1]}")

    // Build 2D dynamically
    array<array<i32>> dynamic = []
    for (i32 i = 0; i < 3; i++) {
        array<i32> row = []
        for (i32 j = 0; j < 3; j++) {
            row.push(i * 3 + j)
        }
        dynamic.push(row)
    }
    fmt.print("dynamic: ")
    for row in dynamic {
        fmt.print("[")
        for (i32 j = 0; j < row.len(); j++) {
            if j > 0 { fmt.print(",") }
            fmt.print(f"{row[j]}")
        }
        fmt.print("] ")
    }
    fmt.println("")

    // Nested contains
    fmt.println(f"matrix contains [1,2,3]: {matrix[0].contains(1)}")

    // Nested get
    array<i32> row0, err ge = matrix.get(0)
    fmt.println(f"nested get ok: {ge == ok}")
    fmt.println(f"nested get[0]: {row0[0]}")

    fmt.println("===== TEST 09_NESTED_ARRAYS END =====")
    return 0
}
