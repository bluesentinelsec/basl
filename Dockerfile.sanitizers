FROM ubuntu:24.04

RUN apt-get update -qq && apt-get install -y -qq \
    clang cmake make python3 llvm \
    libasound2-dev libpulse-dev libx11-dev libxext-dev \
    libxrandr-dev libxcursor-dev libxfixes-dev libxi-dev libxss-dev \
    libxtst-dev libxkbcommon-dev libdrm-dev libgbm-dev \
    libgl-dev libgles-dev libegl-dev libdbus-1-dev libudev-dev \
    libwayland-dev libdecor-0-dev wayland-protocols \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /vigil
COPY . .

ENV ASAN_OPTIONS=detect_leaks=1:halt_on_error=1:detect_odr_violation=0
ENV UBSAN_OPTIONS=print_stacktrace=1:halt_on_error=1

RUN cmake -S . -B build \
    -DVIGIL_BUILD_TESTS=ON \
    -DVIGIL_PLUGIN_SDL=ON \
    -DVIGIL_PLUGIN_GUI=ON \
    -DVIGIL_PLUGIN_AUDIO=ON \
    -DVIGIL_PLUGIN_SYSQUERY=ON \
    -DCMAKE_BUILD_TYPE=Debug \
    -DCMAKE_C_COMPILER=clang \
    -DCMAKE_CXX_COMPILER=clang++ \
    "-DCMAKE_C_FLAGS_DEBUG=-fsanitize=address,undefined -fno-omit-frame-pointer" \
    "-DCMAKE_CXX_FLAGS_DEBUG=-fsanitize=address,undefined -fno-omit-frame-pointer" \
    "-DCMAKE_EXE_LINKER_FLAGS_DEBUG=-fsanitize=address,undefined" \
    "-DCMAKE_SHARED_LINKER_FLAGS_DEBUG=-fsanitize=address,undefined"

RUN cmake --build build --config Debug

CMD ["ctest", "--test-dir", "build", "--output-on-failure", "-C", "Debug"]
